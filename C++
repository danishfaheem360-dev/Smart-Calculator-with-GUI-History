#include <iostream>
#include <vector>
#include <string>
#include <limits>

using namespace std;

// Function to display history
void showHistory(const vector<string>& history) {
    if (history.empty()) {
        cout << "No history yet." << endl;
    } else {
        cout << "Last " << min(5, (int)history.size()) << " calculations:" << endl;
        int start = max(0, (int)history.size() - 5);
        for (int i = start; i < history.size(); ++i) {
            cout << history[i] << endl;
        }
    }
}

int main() {
    vector<string> history; // Stores calculation history
    double num1, num2, result;
    char op;
    bool running = true;

    cout << "=== Smart Calculator ===" << endl;

    while (running) {
        cout << "\nEnter first number (or 'q' to quit): ";
        if (!(cin >> num1)) {
            string quitCheck;
            cin.clear();
            cin >> quitCheck;
            if (quitCheck == "q" || quitCheck == "Q") {
                break;
            } else {
                cout << "Invalid input! Try again." << endl;
                cin.ignore(numeric_limits<streamsize>::max(), '\n');
                continue;
            }
        }

        cout << "Enter operator (+, -, *, /, h for history, q to quit): ";
        cin >> op;

        if (op == 'q' || op == 'Q') break;
        if (op == 'h' || op == 'H') {
            showHistory(history);
            continue;
        }

        cout << "Enter second number: ";
        if (!(cin >> num2)) {
            cout << "Invalid input! Try again." << endl;
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            continue;
        }

        string entry = to_string(num1) + " " + op + " " + to_string(num2) + " = ";

        switch (op) {
            case '+': result = num1 + num2; break;
            case '-': result = num1 - num2; break;
            case '*': result = num1 * num2; break;
            case '/':
                if (num2 == 0) {
                    cout << "Error: Division by zero!" << endl;
                    continue;
                }
                result = num1 / num2;
                break;
            default:
                cout << "Invalid operator! Try again." << endl;
                continue;
        }

        cout << "Result: " << result << endl;
        entry += to_string(result);
        history.push_back(entry);
    }

    cout << "\nThank you for using Smart Calculator!" << endl;
    return 0;
}
